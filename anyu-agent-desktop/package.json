{
  "name": "anyu-agent-desktop",
  "version": "1.0.18",
  "description": "AnYuAgent standalone desktop workspace powered by Pi",
  "main": "main.cjs",
  "author": "AnYu AI",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test:planner": "node tools/test-video-planner.cjs",
    "test:timeline": "node tools/test-timeline.cjs",
    "test:updater": "node tools/test-updater.cjs",
    "prepare:electron": "node node_modules/electron/install.js",
    "dist": "npm run prepare:electron && electron-builder --win nsis",
    "dist:mac:arm64": "npm run prepare:electron && electron-builder --mac dmg zip --arm64",
    "dist:mac:x64": "npm run prepare:electron && electron-builder --mac dmg zip --x64"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.anyu.agent",
    "productName": "AnYuAgent",
    "artifactName": "AnYuAgent-Setup-${version}.exe",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "updater.cjs",
      "renderer/**/*",
      "branding/**/*"
    ],
    "extraResources": [
      {
        "from": "pi-runtime",
        "to": "pi-runtime"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "branding/anyu.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "branding/logo.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "AnYuAgent-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AnYuAgent"
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false
  }
}
