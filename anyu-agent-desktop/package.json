{
  "name": "anyu-agent-desktop",
  "version": "1.0.64",
  "description": "AnyuAgent standalone desktop workspace",
  "main": "main.cjs",
  "author": "Anyu AI",
  "license": "MIT",
  "dependencies": {
    "archiver": "7.0.1",
    "parse5": "7.3.0",
    "sanitize-html": "2.17.0",
    "undici": "7.29.0",
    "unzipper": "0.12.5",
    "qrcode": "1.5.4"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs && node --check renderer/app.js && node --check local-detail.cjs && node --check detail-thumbnails.cjs && node --check dependency-manager.cjs && node --check dependency-download.cjs && node --check agent-session.cjs && node --check skill-manager.cjs && node --check pi-approval-gate.mjs",
    "test:detail-thumbnails": "electron tools/test-detail-thumbnail-live.cjs",
    "test:detail-ipc": "electron tools/test-detail-workflow-ipc-live.cjs",
    "test:planner": "node tools/test-video-planner.cjs",
    "test:gateway-bridge": "node tools/test-gateway-bridge.cjs",
    "test:route-mode": "node tools/test-route-mode.cjs",
    "test:media-skill": "node tools/test-media-skill-trigger.cjs",
    "test:browser-layout": "node tools/test-browser-layout.cjs",
    "test:browser-policy": "node tools/test-browser-policy.cjs",
    "test:browser-tool": "node tools/test-browser-tool.cjs",
    "test:browser-live": "electron tools/test-browser-live.cjs",
    "test:feedback-live": "electron tools/test-feedback-live.cjs",
    "test:feedback-report": "node tools/test-feedback-report.cjs",
    "test:feedback-pipeline": "node tools/test-feedback-pipeline.cjs",
    "test:feedback-report-live": "electron tools/test-feedback-report-live.cjs",
    "test:tmall-detail-reference": "node tools/test-tmall-detail-reference.cjs",
    "test:one-click-detail": "node tools/test-one-click-detail-workflow.cjs",
    "test:skill-analysis": "node tools/test-skill-analysis.cjs",
    "test:media-result": "node tools/test-media-result-render.cjs",
    "test:vision-capability": "node tools/test-vision-capability.cjs",
    "test:business-skill": "node tools/test-business-skill-contract.cjs",
    "test:skill-menu": "node tools/test-skill-menu.cjs",
    "test:skill-menu-live": "electron tools/test-skill-menu-session-live.cjs",
    "test:image-plan-display": "node tools/test-image-plan-display.cjs",
    "test:skills-browser": "node tools/test-skills-browser.cjs",
    "test:commerce-skills": "node tools/test-commerce-browser.cjs && node tools/test-browser-tool.cjs && node tools/test-commerce-skills.cjs && node tools/test-commerce-package-install.cjs",
    "test:plugin-install-ui": "node tools/test-plugin-install-no-restart.cjs",
    "package:skills": "node tools/package-builtin-skills.cjs",
    "test:plugins": "node tools/test-plugin-manager.cjs",
    "test:dependencies": "node tools/test-dependency-manager.cjs",
    "test:timeline": "node tools/test-timeline.cjs",
    "test:appearance": "node tools/test-appearance-theme.cjs",
    "test:streaming": "node tools/test-streaming-reveal.cjs",
    "test:turn-ui": "node tools/test-turn-artifacts.cjs",
    "preview:streaming": "electron tools/preview-streaming-reveal.cjs",
    "test:updater": "node tools/test-updater.cjs",
    "test:update-manual-install": "node tools/test-update-manual-install.cjs",
    "test:attachment-menu": "node tools/test-attachment-menu.cjs",
    "test:queue-release": "node tools/test-queue-release.cjs",
    "test:session-recovery": "node tools/test-session-recovery.cjs",
    "test:skill-tool-failure-policy": "node tools/test-skill-tool-failure-policy.cjs",
    "test:shop-monitor": "node tools/test-shop-monitor-collector.cjs",
    "test:elevation": "node tools/test-elevation-intent.cjs && node tools/test-elevation-ipc.cjs",
    "test:thinking": "node tools/test-thinking-presets.cjs",
    "test:permission": "node tools/test-permission-no-restart.cjs",
    "preview:composer": "electron tools/preview-composer.cjs",
    "prepare:electron": "node node_modules/electron/install.js",
    "test:packaged-path": "node tools/test-packaged-extension-path.cjs",
    "test:drop-overlay": "node tools/test-drop-overlay.cjs",
    "test:model-switch": "node tools/test-model-switch-resilience.cjs",
    "diagnose:model-switch": "electron tools/diagnose-model-switch.cjs",
    "dist": "node tools/build-vue-renderer.cjs && npm run prepare:electron && electron-builder --win nsis",
    "dist:mac:arm64": "npm run prepare:electron && electron-builder --mac dmg zip --arm64",
    "dist:mac:x64": "npm run prepare:electron && electron-builder --mac dmg zip --x64",
    "test:recharge": "node tools/test-recharge-contract.cjs"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.anyu.agent",
    "productName": "AnyuAgent",
    "artifactName": "AnyuAgent-Setup-${version}.exe",
    "asar": true,
    "asarUnpack": [
      "pi-subagent-extension.mjs",
      "pi-browser-extension.mjs",
      "pi-approval-gate.mjs",
      "tools/auto_edit_worker.py",
      "skills/**/*"
    ],
    "files": [
      "main.cjs",
      "renderer-protocol.cjs",
      "browser-layout.cjs",
      "browser-policy.cjs",
      "commerce-browser.cjs",
      "commerce-access.cjs",
      "electron-page.cjs",
      "feedback-worker.cjs",
      "feedback-report.cjs",
      "shop-analysis.cjs",
      "tools/auto_edit_worker.py",
      "tools/build-vue-renderer.cjs",
      "tools/windows-shell-bootstrap.cjs",
      "local-feedback.cjs",
      "local-detail.cjs",
      "detail-thumbnails.cjs",
      "skill-analysis.cjs",
      "skill-manager.cjs",
      "skills/**/*",
      "agent-session.cjs",
      "agent-orchestrator.cjs",
      "pi-subagent-extension.mjs",
      "pi-browser-extension.mjs",
      "pi-approval-gate.mjs",
      "gateway-bridge.cjs",
      "elevation-intent.cjs",
      "thinking-presets.js",
      "plugin-manager.cjs",
      "dependency-manager.cjs",
      "dependency-download.cjs",
      "preload.cjs",
      "updater.cjs",
      "shutdown.cjs",
      "renderer/**/*",
      "renderer-vue/**/*",
      "branding/**/*"
    ],
    "extraResources": [
      {
        "from": "pi-runtime",
        "to": "pi-runtime"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "branding/anyu.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "branding/logo.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "AnyuAgent-${version}-${arch}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AnyuAgent"
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false
  }
}
